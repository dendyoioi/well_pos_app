{
  "name": "well-pos-workspace",
  "version": "1.0.0",
  "description": "Well POS — Multi-Tenant SaaS Point of Sale, Inventory Ledger & Supply Chain Platform",
  "private": true,
  "scripts": {
    "dev:sandbox": "./run-sandbox.sh",
    "seed:sandbox": "npm run seed:sandbox --prefix pos_apps/server",
    "seed:testbed": "npm run seed:testbed --prefix pos_apps/server",
    "test:sandbox": "npm run test:sandbox --prefix pos_apps/server",
    "test:smoke": "npm run test:smoke --prefix pos_apps/server",
    "test:visual": "NODE_PATH=./pos_apps/node_modules node scripts/test_tenant_journey_visual_paths.js",
    "test:visual:recipes": "NODE_PATH=./pos_apps/node_modules node scripts/test_fnb_recipes_deduction_visual.js",
    "test:visual:split-debt": "NODE_PATH=./pos_apps/node_modules node scripts/test_split_debt_bdd_visual.js",
    "test:visual:shift-audit": "NODE_PATH=./pos_apps/node_modules node scripts/test_end_of_shift_financial_audit_bdd_visual.js",
    "test:visual:shift": "NODE_PATH=./pos_apps/node_modules node scripts/test_end_of_shift_financial_audit_bdd_visual.js",
    "test:visual:linear": "NODE_PATH=./pos_apps/node_modules node scripts/test_tenant_journey_visual.js",
    "dev:server": "npm run dev --prefix pos_apps/server",
    "dev:client": "npm run dev --prefix pos_apps/client",
    "build:client": "npm run build --prefix pos_apps/client",
    "build:server": "npm run build --prefix pos_apps/server"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "saas",
    "multi-tenant",
    "inventory",
    "fnb",
    "retail"
  ],
  "author": "Well POS Team",
  "license": "ISC"
}
