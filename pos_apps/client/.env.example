# ====================================================================
# WELL POS — CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Salin berkas ini ke .env di pos_apps/client untuk pengembangan lokal (opsional, default: proxy Vite).
# Pada deployment Vercel Staging/Production, set variabel VITE_API_URL ini di Project Settings.
# ====================================================================

# Base URL Backend API
# Kosongkan atau abaikan saat dev lokal (Vite otomatis mem-proxy /api ke localhost:5001)
# Staging DEV: https://wellpos-api-dev.onrender.com
# Production: https://api.wellpos.id
VITE_API_URL=https://wellpos-api-dev.onrender.com
