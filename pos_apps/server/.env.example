# ====================================================================
# WELL POS — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Salin berkas ini ke .env di pos_apps/server untuk pengembangan lokal,
# atau pasang variabel berikut pada dashboard Staging/Produksi (Render, Vercel, Supabase, GCP).
# ====================================================================

# 1. SERVER & RUNTIME
PORT=5001
NODE_ENV=development # 'development' | 'production' | 'test'

# 2. DATABASE (POSTGRESQL)
# Untuk database lokal:
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/pos_db?schema=public"
# Untuk Supabase Transaction Pooler (Port 6543, direkomendasikan untuk runtime API di Render):
# Rekomendasi parameter pooler: ?pgbouncer=true&connection_limit=5&pool_timeout=20
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
#
# Untuk Supabase Direct Connection (Port 5432) — Wajib untuk migrasi DDL / SchemaPatcher:
# Rekomendasi parameter direct: ?connection_limit=2
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?connection_limit=2"

# 3. AUTENTIKASI & KEAMANAN
JWT_SECRET="rahasia_super_aman_pos_well_dev_jwt_key_12345"

# 4. CORS & FRONTEND CLIENT ORIGIN
# Izinkan origin frontend Staging / Produksi (pisahkan dengan koma jika multi-domain)
CLIENT_ORIGIN="http://localhost:5173,https://beta.wellpos.id,https://wellpos.id"
FRONTEND_URL="https://beta.wellpos.id"
CLIENT_URL="https://beta.wellpos.id"

# 5. CLOUDFLARE R2 OBJECT STORAGE
# (Opsional untuk testing lokal; fallback ke local storage disk server jika belum diisi)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
STORAGE_ENV_PREFIX="dev" # 'dev' untuk bucket dev/staging, 'prod' untuk bucket produksi

# 6. WHATSAPP GATEWAY (FONNTE)
# Digunakan untuk notifikasi struk digital, link tracking laundry, dan pengingat cucian mengendap
FONNTE_API_KEY=""
FONNTE_SENDER_NUMBER=""

# 7. PAYMENT GATEWAY (PAKASIR QRIS & VA)
PAKASIR_API_KEY=""
PAKASIR_SLUG=""
PAKASIR_BASE_URL="https://api.pakasir.com"
PAKASIR_WEBHOOK_SECRET=""
PAKASIR_MODE="sandbox" # 'sandbox' | 'production'

# 8. EMAIL SERVICE (RESEND / SMTP)
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tokoanda@gmail.com"
SMTP_PASS="password_aplikasi"
SMTP_FROM="Well POS <no-reply@wellpos.id>"

# 9. BACKUP SCHEDULER & REDIS (OPSIONAL)
BACKUP_CRON_ENABLED="false"
BACKUP_CRON_HOUR=2
# REDIS_URL="redis://localhost:6379"
