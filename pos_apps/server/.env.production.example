# ========================================================
# PANDUAN KONFIGURASI REMOTE DATABASE SUPABASE (PORT 5432)
# ========================================================
# Buat salinan file ini dengan nama: .env.production (di folder pos_apps/server/)
# File .env.production otomatis ter-ignore oleh git sehingga credential aman.
#
# Dapatkan URL dari:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# PENTING: Pilih mode "Direct connection" (Port 5432), BUKAN Transaction Pooler (Port 6543)
#
# Format:
REMOTE_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
