  tenantId        String    @map("tenant_id")
  orderId         String    @map("order_id")
  laundryDetailId String    @map("laundry_detail_id")
  stage           String    // DROP_OFF, TAGGING, SORTING, SPOTTING, WASHING, DRYING, IRONING, FOLDING, PACKING, RACK_STORAGE, HANDOVER
