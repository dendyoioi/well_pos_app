// ==========================================
// TARGET DATABASE PRISMA SCHEMA SPECIFICATION
// Multi-Tenant SaaS POS Platform (Retail, F&B, Services)
// Baseline: /docs/architecture/04_TARGET_DATABASE_SCHEMA.md (Revision 4)
// Architecture Status: READY FOR OWNER APPROVAL / Architecture Locked
// ==========================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. SAAS PLATFORM FOUNDATION (GLOBAL & ROOT)
// ==========================================

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         PlatformRole @default(SUPPORT)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  verifiedPayments SaaSPayment[] @relation("VerifiedByPlatformUser")

  @@map("platform_users")
}

model Tenant {
  id                   String           @id @default(uuid())
  name                 String           @map("business_name")
  slug                 String           @unique
  businessVertical     BusinessVertical @default(RETAIL) @map("business_vertical")
  status               TenantStatus     @default(TRIAL)
  businessType         String?          @default("Retail") @map("business_type")
  phone                String?
  trialEndsAt          DateTime?        @map("trial_ends_at")
  allowNegativeStock   Boolean          @default(false) @map("allow_negative_stock")
  enableBatchTracking  Boolean          @default(false) @map("enable_batch_tracking")
  enableRecipeTracking Boolean          @default(false) @map("enable_recipe_tracking")
  laundryStages        Json?            @map("laundry_stages")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  // Relationships to Tenant-Owned Operational Data
  users                 User[]
  outlets               Outlet[]
  categories            Category[]
  products              Product[]
  productVariants       ProductVariant[]
  storageLocations      StorageLocation[]
  inventoryItems        InventoryItem[]
  inventoryBatches      InventoryBatch[]
  inventoryBalances     InventoryBalance[]
  inventoryLedgers      InventoryLedger[]
  recipes               Recipe[]
  recipeItems           RecipeItem[]
  modifierGroups        ModifierGroup[]
  modifierItems         ModifierItem[]
  productModifierGroups ProductModifierGroup[]
  modifierRecipeEffects ModifierRecipeEffect[]
  orders                Order[]
  orderItems            OrderItem[]
  paymentTransactions   PaymentTransaction[]
  refunds               Refund[]
  refundItems           RefundItem[]
  shifts                Shift[]
  cashMovements         CashMovement[]
  customers             Customer[]
  idempotencyRecords    IdempotencyRecord[]
  subscriptions         TenantSubscription[]
  invoices              SaaSInvoice[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderItems    PurchaseOrderItem[]
  stockTransfers        StockTransfer[]
  outletProducts        OutletProduct[]
  stockTransferItems    StockTransferItem[]
  promotions            Promotion[]
  promotionUsages       PromotionUsage[]
  promotionItems        PromotionItem[]
  customerPointLedgers  CustomerPointLedger[]
  customerDebts         CustomerDebt[]
  customerDebtPayments  CustomerDebtPayment[]
  attendances           Attendance[]
  productBundleItems    ProductBundleItem[]
  productPriceTiers     ProductPriceTier[]
  laundryServices       LaundryService[]
  laundryRacks          LaundryRack[]
  laundryOrderDetails   LaundryOrderDetail[]
  laundryTransferManifests LaundryTransferManifest[]
  laundryStageLogs      LaundryStageLog[]
  customerLaundryWallets CustomerLaundryWallet[]
  customerLaundryWalletLedgers CustomerLaundryWalletLedger[]
  laundryServiceBomItems LaundryServiceBomItem[]
  shiftCashDeposits ShiftCashDeposit[]
  staffCashAdvances StaffCashAdvance[]
  laundryFeedbacks  LaundryCustomerFeedback[]
  laundryPerfumes   LaundryPerfume[]
  laundryMachines   LaundryMachine[]

  @@map("tenants")
}

model SubscriptionPlan {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  price        Decimal      @db.Decimal(15, 2)
  billingCycle BillingCycle @default(MONTHLY) @map("billing_cycle")
  maxOutlets   Int          @default(1) @map("max_outlets")
  maxCashiers  Int          @default(3) @map("max_cashiers")
  features     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]
  invoices      SaaSInvoice[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  planId    String    @map("plan_id")
  startedAt DateTime  @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, isActive])
  @@map("tenant_subscriptions")
}

model SaaSInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  tenantId       String        @map("tenant_id")
  planId         String        @map("plan_id")
  amount         Decimal       @db.Decimal(15, 2)
  tokenAmount    Int?          @map("token_amount")
  notes          String?
  promoCode      String?       @map("promo_code")
  discountAmount Decimal?      @default(0) @db.Decimal(15, 2) @map("discount_amount")
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime      @map("due_date")
  paymentUrl     String?       @map("payment_url")
  qrString       String?       @map("qr_string")
  externalTxnId  String?       @map("external_txn_id")
  paymentGateway String?       @default("PAKASIR") @map("payment_gateway")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SaaSPayment[]

  @@index([tenantId, status])
  @@map("saas_invoices")
}

model SaaSPayment {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  paymentChannel  String   @map("payment_channel")
  paymentProofUrl String?  @map("payment_proof_url")
  verifiedById    String?  @map("verified_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice    SaaSInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  verifiedBy PlatformUser? @relation("VerifiedByPlatformUser", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("saas_payments")
}

model SaaSPromo {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?   @map("description")
  type        String    // 'DISCOUNT_PERCENT' | 'DISCOUNT_FIXED' | 'BONUS_TOKENS'
  value       Decimal   @db.Decimal(15, 2)
  minSpend    Decimal?  @default(0) @db.Decimal(15, 2) @map("min_spend")
  maxDiscount Decimal?  @db.Decimal(15, 2) @map("max_discount")
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  scope       String    @default("ALL") @map("scope") // 'ALL' | 'REGISTRATION' | 'TOPUP'
  validFrom   DateTime  @default(now()) @map("valid_from")
  validUntil  DateTime? @map("valid_until")
  isActive    Boolean   @default(true) @map("is_active")
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("saas_promos")
}

// ==========================================
// 2. CORE PLATFORM & IAM (MODEL B)
// ==========================================

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  outletId     String?   @map("outlet_id") // NULL = Tenant-wide; Non-NULL = Branch-restricted
  userCode     String    @map("user_code") // e.g. "KSR001"
  name         String
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  email        String?
  phone        String?
  passwordHash String?   @map("password_hash")
  pinHash      String?   @map("pin_hash") // Nullable per OD-13.3-03 (Bcrypt hash of operational PIN; NULL for PIN-less users)
  role         Role      @default(CASHIER)
  canCashOut   Boolean   @default(false) @map("can_cash_out")
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(1) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet         Outlet?           @relation(fields: [outletId], references: [id], onDelete: Restrict)
  orders         Order[]           @relation("CashierUser")
  shifts         Shift[]
  cashMovements  CashMovement[]
  createdLedgers InventoryLedger[] @relation("ActorUser")
  createdPOs          PurchaseOrder[] @relation("POCreatedByUser")
  dispatchedTransfers StockTransfer[] @relation("TransferDispatchedByUser")
  receivedTransfers   StockTransfer[] @relation("TransferReceivedByUser")
  customerDebtPayments CustomerDebtPayment[]
  paymentTransactions PaymentTransaction[]
  attendances         Attendance[]
  laundryStageLogs    LaundryStageLog[]
  customerLaundryWalletLedgers CustomerLaundryWalletLedger[]
  shiftCashDepositsCreated  ShiftCashDeposit[] @relation("DepositCashier")
  shiftCashDepositsVerified ShiftCashDeposit[] @relation("DepositVerifier")
  staffCashAdvances         StaffCashAdvance[] @relation("StaffCashAdvanceUser")
  laundryFeedbacksHandled   LaundryCustomerFeedback[] @relation("FeedbackHandledBy")

  @@unique([tenantId, userCode])
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model Outlet {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code          String?
  name          String
  merchantName  String?   @map("merchant_name")
  address       String?
  phone         String?
  industries    Json?     @map("industries")
  isWarehouse   Boolean?  @default(false) @map("is_warehouse")
  isWorkshop    Boolean?  @default(false) @map("is_workshop")
  warehouseId   String?   @map("warehouse_id")
  timezone      String?   @default("Asia/Jakarta") @map("timezone")
  receiptConfig Json?     @map("receipt_config")
  feesConfig    Json?     @map("fees_config")
  channelsConfig Json?    @map("channels_config")
  paymentConfig Json?     @map("payment_config")
  loyaltyConfig Json?     @map("loyalty_config")
  attendanceConfig Json?  @map("attendance_config")
  laundryStages Json?     @map("laundry_stages")
  laundryDeliveryConfig Json? @map("laundry_delivery_config")
  laundryCommissionConfig Json? @map("laundry_commission_config")
  laundryDepositConfig Json? @map("laundry_deposit_config")
  googleReviewUrl      String? @map("google_review_url")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users            User[]
  storageLocations StorageLocation[]
  orders           Order[]
  shifts           Shift[]
  cashMovements    CashMovement[]
  purchaseOrders   PurchaseOrder[]
  sourceTransfers  StockTransfer[]   @relation("TransferSourceOutlet")
  targetTransfers  StockTransfer[]   @relation("TransferTargetOutlet")
  outletProducts   OutletProduct[]
  customerDebts    CustomerDebt[]
  customerDebtPayments CustomerDebtPayment[]
  paymentTransactions PaymentTransaction[]
  attendances      Attendance[]
  laundryRacks     LaundryRack[]
  laundryOrderDetails LaundryOrderDetail[]
  sourceLaundryManifests LaundryTransferManifest[] @relation("ManifestSourceOutlet")
  targetLaundryManifests LaundryTransferManifest[] @relation("ManifestTargetOutlet")
  customerLaundryWalletLedgers CustomerLaundryWalletLedger[]
  shiftCashDeposits ShiftCashDeposit[]
  staffCashAdvances StaffCashAdvance[]
  laundryFeedbacks  LaundryCustomerFeedback[]
  laundryPerfumes   LaundryPerfume[]
  laundryMachines   LaundryMachine[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("outlets")
}

model Shift {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  outletId       String      @map("outlet_id")
  userId         String      @map("cashier_id")
  startTime      DateTime    @default(now()) @map("start_time")
  endTime        DateTime?   @map("end_time")
  startingCash   Decimal     @map("starting_cash") @db.Decimal(15, 2)
  expectedEnding Decimal     @default(0) @map("expected_cash") @db.Decimal(15, 2)
  actualEnding   Decimal?    @map("actual_cash") @db.Decimal(15, 2)
  cashDifference Decimal?    @map("difference") @db.Decimal(15, 2)
  status         ShiftStatus @default(OPEN)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]
  cashMovements CashMovement[]
  customerDebtPayments CustomerDebtPayment[]
  paymentTransactions PaymentTransaction[]
  customerLaundryWalletLedgers CustomerLaundryWalletLedger[]
  cashDeposits      ShiftCashDeposit[]
  staffCashAdvances StaffCashAdvance[]

  @@index([tenantId, outletId, status])
  @@map("shifts")
}

model CashMovement {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  outletId  String           @map("outlet_id")
  shiftId   String           @map("shift_id")
  userId    String           @map("user_id")
  type      CashMovementType @default(CASH_OUT)
  category  String
  amount    Decimal          @db.Decimal(15, 2)
  notes     String
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, shiftId])
  @@map("cash_movements")
}

enum CashMovementType {
  CASH_OUT
  CASH_IN
}

model Customer {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  code          String?
  name          String
  phone         String?
  email         String?
  address       String?
  tier          CustomerTier @default(BRONZE)
  loyaltyPoints Int          @default(0) @map("loyalty_points")
  totalSpent    Decimal      @default(0) @map("total_spent") @db.Decimal(15, 2)
  visitCount    Int          @default(0) @map("visit_count")
  lastWinbackSentAt DateTime? @map("last_winback_sent_at")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders          Order[]
  pointLedgers    CustomerPointLedger[]
  promotionUsages PromotionUsage[]
  debts           CustomerDebt[]
  laundryWallet   CustomerLaundryWallet?
  laundryFeedbacks LaundryCustomerFeedback[]

  @@unique([tenantId, code])
  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

// ==========================================
// 3. COMMERCE & CATALOG
// ==========================================

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  parentId  String?  @map("parent_id")
  name      String
  slug      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  // Note: Root categories (parentId IS NULL) uniqueness per tenant enforced via PostgreSQL partial index:
  // CREATE UNIQUE INDEX "uq_category_root" ON "categories" ("tenant_id", "name") WHERE "parent_id" IS NULL;
  @@unique([tenantId, parentId, name])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  categoryId  String?     @map("category_id")
  name        String
  description String?
  sku         String?
  unit        String?     @default("Pcs")
  imageUrl    String?     @map("image_url")
  type        ProductType @default(STANDARD) // STANDARD, COMPOSITE, SERVICE_LABOR
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category       Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  outletProducts OutletProduct[]
  promotionItems PromotionItem[]
  bundleItemsAsParent ProductBundleItem[] @relation("BundleParent")
  bundleItemsAsChild  ProductBundleItem[] @relation("BundleChild")
  priceTiers          ProductPriceTier[]

  @@index([tenantId, categoryId])
  @@index([tenantId, type, isActive])
  @@map("products")
}

model ProductVariant {
  id                          String   @id @default(uuid())
  tenantId                    String   @map("tenant_id")
  productId                   String   @map("product_id")
  inventoryItemId             String?  @map("inventory_item_id") // N:1 to InventoryItem
  sku                         String
  barcode                     String?
  name                        String // e.g. "Default", "Large", "Carton 24"
  price                       Decimal  @db.Decimal(15, 2)
  inventoryQuantityMultiplier Decimal  @default(1.000) @map("inventory_quantity_multiplier") @db.Decimal(12, 3)
  isActive                    Boolean  @default(true) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  recipe         Recipe?
  orderItems     OrderItem[]
  promotionItems PromotionItem[]
  bundleItemsAsParent ProductBundleItem[] @relation("BundleVariantParent")
  bundleItemsAsChild  ProductBundleItem[] @relation("BundleChildVariant")
  priceTiers          ProductPriceTier[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@index([tenantId, inventoryItemId])
  @@map("product_variants")
}

model OutletProduct {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  outletId      String   @map("outlet_id")
  productId     String   @map("product_id")
  isAvailable   Boolean  @default(true) @map("is_available")
  priceOverride Decimal? @map("price_override") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet  Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([outletId, productId])
  @@index([tenantId, outletId])
  @@map("outlet_products")
}

model ProductBundleItem {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  bundleProductId       String   @map("bundle_product_id")
  bundleVariantId       String?  @map("bundle_variant_id")
  childProductId        String   @map("child_product_id")
  childVariantId        String?  @map("child_variant_id")
  quantity              Decimal  @default(1.0000) @map("quantity") @db.Decimal(12, 4)
  costAllocationPercent Decimal? @map("cost_allocation_percent") @db.Decimal(5, 2)
  slotName              String?  @map("slot_name") @db.VarChar(100)
  priceAdjustment       Decimal  @default(0) @map("price_adjustment") @db.Decimal(15, 2)
  isDefault             Boolean  @default(false) @map("is_default")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bundleProduct Product         @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  bundleVariant ProductVariant? @relation("BundleVariantParent", fields: [bundleVariantId], references: [id], onDelete: Cascade)
  childProduct  Product         @relation("BundleChild", fields: [childProductId], references: [id], onDelete: Restrict)
  childVariant  ProductVariant? @relation("BundleChildVariant", fields: [childVariantId], references: [id], onDelete: Restrict)

  @@index([tenantId, bundleProductId])
  @@index([tenantId, childProductId])
  @@map("product_bundle_items")
}

model ProductPriceTier {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  minQuantity Int      @map("min_quantity")
  tierPrice   Decimal  @map("tier_price") @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, variantId, minQuantity])
  @@index([tenantId, productId])
  @@map("product_price_tiers")
}

// ==========================================
// 4. LOGISTICS & INVENTORY
// ==========================================

model UnitConversion {
  id               String  @id @default(uuid())
  fromUom          String  @map("from_uom")
  toUom            String  @map("to_uom")
  conversionFactor Decimal @map("conversion_factor") @db.Decimal(12, 6)
  uomType          UomType @map("uom_type") // MASS, VOLUME, COUNT, LENGTH, TIME
  isBase           Boolean @default(false) @map("is_base")

  @@unique([fromUom, toUom])
  @@map("unit_conversions")
}

model StorageLocation {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  outletId           String              @map("outlet_id")
  name               String // e.g. "Main Kitchen", "Bar Storage", "Front Display"
  type               StorageLocationType @default(STOREFRONT)
  isDefault          Boolean             @default(false) @map("is_default")
  allowNegativeStock Boolean?            @map("allow_negative_stock") // Nullable override
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet          Outlet             @relation(fields: [outletId], references: [id], onDelete: Restrict)
  balances        InventoryBalance[]
  ledgers         InventoryLedger[]
  purchaseOrders  PurchaseOrder[]
  sourceTransfers StockTransfer[]    @relation("TransferSourceLocation")
  targetTransfers StockTransfer[]    @relation("TransferTargetLocation")

  // Note: Exactly one default location per outlet enforced via PostgreSQL partial index:
  // CREATE UNIQUE INDEX "uq_storage_location_default" ON "storage_locations" ("tenant_id", "outlet_id") WHERE "is_default" = true;
  @@unique([tenantId, outletId, name])
  @@index([tenantId, outletId, isDefault])
  @@map("storage_locations")
}

model InventoryItem {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  itemCode           String   @map("item_code")
  name               String
  description        String?
  canonicalUom             String   @map("canonical_uom") // KG, GRAM, LITER, ML, PCS
  purchaseUom              String?  @map("purchase_uom") // CARTON, SACK, CAN, JERIGEN, BOTOL, PACK
  purchaseConversionFactor Decimal  @default(1) @map("purchase_conversion_factor") @db.Decimal(12, 4)
  reorderPoint             Decimal  @default(0) @map("reorder_point") @db.Decimal(12, 3)
  targetLevel        Decimal  @default(0) @map("target_level") @db.Decimal(12, 3)
  averageCost        Decimal  @default(0) @map("average_cost") @db.Decimal(15, 4)
  allowNegativeStock Boolean? @map("allow_negative_stock") // Nullable override
  isBatched          Boolean  @default(false) @map("is_batched")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  batches               InventoryBatch[]
  balances              InventoryBalance[]
  ledgers               InventoryLedger[]
  recipeItems           RecipeItem[]
  modifierRecipeEffects ModifierRecipeEffect[]
  purchaseOrderItems    PurchaseOrderItem[]
  stockTransferItems    StockTransferItem[]
  laundryBomItems       LaundryServiceBomItem[]
  laundryPerfumes       LaundryPerfume[]

  @@unique([tenantId, itemCode])
  @@index([tenantId, isActive])
  @@map("inventory_items")
}

model InventoryBatch {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  inventoryItemId String    @map("inventory_item_id")
  batchNumber     String    @map("batch_number")
  expirationDate  DateTime? @map("expiration_date")
  receivedDate    DateTime  @default(now()) @map("received_date")
  costPrice       Decimal   @map("cost_price") @db.Decimal(15, 4)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  balances           InventoryBalance[]
  ledgers            InventoryLedger[]
  stockTransferItems StockTransferItem[]

  @@unique([tenantId, inventoryItemId, batchNumber])
  @@index([tenantId, expirationDate])
  @@map("inventory_batches")
}

model InventoryBalance {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  inventoryItemId   String   @map("inventory_item_id")
  storageLocationId String   @map("storage_location_id")
  inventoryBatchId  String?  @map("inventory_batch_id")
  quantityOnHand    Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  quantityReserved  Decimal  @default(0) @map("quantity_reserved") @db.Decimal(12, 3)
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  inventoryBatch  InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  // Note: Two distinct dimension uniqueness constraints enforced via PostgreSQL partial indexes:
  // Unbatched: ("tenant_id", "inventory_item_id", "storage_location_id") WHERE "inventory_batch_id" IS NULL;
  // Batched: ("tenant_id", "inventory_item_id", "storage_location_id", "inventory_batch_id") WHERE "inventory_batch_id" IS NOT NULL;
  @@index([tenantId, inventoryItemId, storageLocationId])
  @@map("inventory_balances")
}

model InventoryLedger {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  inventoryItemId   String  @map("inventory_item_id")
  storageLocationId String  @map("storage_location_id")
  inventoryBatchId  String? @map("inventory_batch_id")

  quantityDelta Decimal @map("quantity_delta") @db.Decimal(12, 3) // Signed (+/-)
  balanceBefore Decimal @map("balance_before") @db.Decimal(12, 3)
  balanceAfter  Decimal @map("balance_after") @db.Decimal(12, 3)
  unitCost      Decimal @map("unit_cost") @db.Decimal(15, 4)

  movementType  StockMovementType @map("movement_type")
  referenceType InventoryRefType  @map("reference_type") // ORDER, PURCHASE_ORDER, TRANSFER, STOCK_OPNAME, REFUND, PRODUCTION, MANUAL
  referenceId   String            @map("reference_id")

  actorType         ActorType @default(USER) @map("actor_type") // USER, SYSTEM
  actorUserId       String?   @map("actor_user_id") // Null for background/system actions
  isNegativeBalance Boolean   @default(false) @map("is_negative_balance")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  inventoryBatch  InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict) // RESTRICT preserves audit history
  actorUser       User?           @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: Restrict) // RESTRICT preserves staff audit link

  @@index([tenantId, inventoryItemId, storageLocationId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_ledgers")
}

// ==========================================
// 5. RECIPES & MODIFIERS (BOM / F&B)
// ==========================================

model Recipe {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  productVariantId String   @unique @map("product_variant_id") // Variant owns Recipe
  instructions     String?
  yieldQuantity    Decimal  @default(1.000) @map("yield_quantity") @db.Decimal(12, 3)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  items          RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  recipeId        String   @map("recipe_id")
  inventoryItemId String   @map("inventory_item_id")
  quantity        Decimal  @db.Decimal(12, 3) // In canonicalUom of inventoryItem
  costRatio       Decimal  @default(1.000) @map("cost_ratio") @db.Decimal(5, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([recipeId, inventoryItemId])
  @@index([tenantId, inventoryItemId])
  @@map("recipe_items")
}

model ModifierGroup {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  name          String // e.g. "Sugar Level", "Toppings", "Milk Alternative"
  selectionType SelectionType @default(SINGLE) @map("selection_type") // SINGLE, MULTIPLE
  minSelection  Int           @default(0) @map("min_selection")
  maxSelection  Int           @default(1) @map("max_selection")
  isRequired    Boolean       @default(false) @map("is_required")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items    ModifierItem[]
  products ProductModifierGroup[]

  @@index([tenantId, name])
  @@map("modifier_groups")
}

model ModifierItem {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  modifierGroupId String   @map("modifier_group_id")
  name            String // e.g. "Less Sugar (50%)", "Boba", "Oat Milk"
  priceAdjustment Decimal  @default(0) @map("price_adjustment") @db.Decimal(15, 2)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modifierGroup ModifierGroup          @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  recipeEffects ModifierRecipeEffect[]

  @@index([tenantId, modifierGroupId])
  @@map("modifier_items")
}

model ProductModifierGroup {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  modifierGroupId String   @map("modifier_group_id")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@unique([productId, modifierGroupId])
  @@index([tenantId, modifierGroupId])
  @@map("product_modifier_groups")
}

model ModifierRecipeEffect {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  modifierItemId  String   @map("modifier_item_id")
  inventoryItemId String   @map("inventory_item_id")
  quantityDelta   Decimal  @map("quantity_delta") @db.Decimal(12, 3) // Signed delta (+/-)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modifierItem  ModifierItem  @relation(fields: [modifierItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([modifierItemId, inventoryItemId])
  @@index([tenantId, inventoryItemId])
  @@map("modifier_recipe_effects")
}

// ==========================================
// 6. SALES & TRANSACTIONS
// ==========================================

model Order {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  outletId      String         @map("outlet_id")
  shiftId       String?        @map("shift_id")
  userId        String         @map("cashier_id") // Cashier
  customerId    String?        @map("customer_id")
  invoiceNumber String         @map("invoice_number")
  orderStatus   OrderStatus?   @default(CONFIRMED) @map("order_status") // DRAFT, CONFIRMED, IN_PROGRESS, READY, COMPLETED, CANCELLED, VOIDED
  paymentStatus PaymentStatus  @default(UNPAID) @map("payment_status") // UNPAID, PARTIALLY_PAID, PAID, PARTIALLY_REFUNDED, REFUNDED
  orderType     String?        @default("DINE_IN") @map("order_type") // DINE_IN, TAKEAWAY, DELIVERY, RETAIL
  channel       String?        @default("DINE_IN") @map("channel") // DINE_IN, TAKEAWAY, GOFOOD, GRABFOOD, SHOPEEFOOD, DELIVERY
  tableNumber   String?        @map("table_number")
  queueNumber   Int?           @map("queue_number")

  subtotal            Decimal  @db.Decimal(15, 2)
  discountTotal       Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxTotal            Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  serviceTotal        Decimal? @default(0) @map("service_total") @db.Decimal(15, 2)
  totalAmount         Decimal  @map("grand_total") @db.Decimal(15, 2)
  paidAmount          Decimal? @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount        Decimal? @default(0) @map("change_amount") @db.Decimal(15, 2)
  promotionId         String?  @map("promotion_id")
  pointsEarned        Int      @default(0) @map("points_earned")
  pointsRedeemed      Int      @default(0) @map("points_redeemed")
  pointDiscountAmount Decimal  @default(0) @map("point_discount_amount") @db.Decimal(15, 2)

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet          Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  shift           Shift?                @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashier         User                  @relation("CashierUser", fields: [userId], references: [id], onDelete: Restrict)
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion       Promotion?            @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        PaymentTransaction[]
  refunds         Refund[]
  promotionUsages PromotionUsage[]
  pointLedgers    CustomerPointLedger[]
  customerDebts   CustomerDebt[]
  laundryDetail   LaundryOrderDetail?
  laundryTransferItems LaundryTransferItem[]
  laundryStageLogs     LaundryStageLog[]
  customerLaundryWalletLedgers CustomerLaundryWalletLedger[]
  laundryFeedback      LaundryCustomerFeedback?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, outletId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, orderStatus, paymentStatus])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  orderId          String  @map("order_id")
  productVariantId String? @map("product_variant_id")

  // Historical Snapshot Fields
  productName       String? @map("product_name")
  variantName       String? @map("variant_name")
  sku               String?
  quantity          Int
  unitPrice         Decimal @map("unit_price") @db.Decimal(15, 2)
  costPrice         Decimal @default(0) @map("cost_price") @db.Decimal(15, 4)
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(15, 2)
  subtotal          Decimal @db.Decimal(15, 2)
  notes             String?
  modifiersSnapshot Json?   @map("modifiers_snapshot") // Immutable array of applied modifiers
  unit              String? @map("unit")
  pricingBasis      String? @map("pricing_basis") // 'KILOAN' | 'SATUAN'
  perfumeVariant    String? @map("perfume_variant")
  laundryServiceId  String? @map("laundry_service_id")
  addonsSnapshot    Json?   @map("addons_snapshot")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  refundItems    RefundItem[]

  @@index([tenantId, orderId])
  @@index([tenantId, productVariantId])
  @@map("order_items")
}

// ==========================================
// 7. FINANCIAL & SETTLEMENT
// ==========================================

model PaymentTransaction {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  orderId         String          @map("order_id")
  shiftId         String?         @map("shift_id")
  outletId        String?         @map("outlet_id")
  cashierId       String?         @map("cashier_id")
  paymentMethod   PaymentMethod   @map("payment_method") // CASH, QRIS, CREDIT_CARD, DEBIT_CARD, BANK_TRANSFER, EWALLET, VOUCHER
  amount          Decimal         @db.Decimal(15, 2)
  referenceNumber String?         @map("reference_number")
  gatewayProvider String?         @map("gateway_provider")
  status          PaymentTxStatus @default(PENDING) // PENDING, CAPTURED, FAILED, REFUNDED, VOIDED
  metadata        Json?
  paidAt          DateTime?       @map("paid_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shift   Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  outlet  Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  cashier User?    @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, shiftId, status])
  @@index([tenantId, outletId])
  @@map("payment_transactions")
}

model Refund {
  id                   String       @id @default(uuid())
  tenantId             String       @map("tenant_id")
  orderId              String       @map("order_id")
  paymentTransactionId String?      @map("payment_transaction_id")
  refundNumber         String       @map("refund_number")
  amount               Decimal      @db.Decimal(15, 2)
  reason               RefundReason @default(CUSTOMER_RETURN)
  notes                String?
  createdAt            DateTime     @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  items              RefundItem[]

  @@unique([tenantId, refundNumber])
  @@index([tenantId, orderId])
  @@map("refunds")
}

model RefundItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  refundId    String  @map("refund_id")
  orderItemId String  @map("order_item_id")
  quantity    Decimal @db.Decimal(12, 3)
  amount      Decimal @db.Decimal(15, 2)
  restockItem Boolean @default(true) @map("restock_item")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, refundId])
  @@index([tenantId, orderItemId])
  @@map("refund_items")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  operationType  String   @map("operation_type") // CHECKOUT, PAYMENT_CAPTURE, WEBHOOK, STOCK_ADJUST
  idempotencyKey String   @map("idempotency_key")
  requestHash    String?  @map("request_hash")
  statusCode     Int?     @map("status_code")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, operationType, idempotencyKey])
  @@index([tenantId, expiresAt])
  @@map("idempotency_records")
}

// ==========================================
// 8. TARGET ENUMS SPECIFICATION
// ==========================================

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  PENDING
}

enum BusinessVertical {
  RETAIL
  FNB
  SERVICES
  HYBRID
}

enum BillingCycle {
  MONTHLY
  ANNUALLY
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  VOID
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  OWNER
  ADMIN
  SUPERVISOR
  WAREHOUSE
  CASHIER
  KITCHEN
  WAITER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ProductType {
  STANDARD
  COMPOSITE
  SERVICE_LABOR
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum UomType {
  MASS
  VOLUME
  COUNT
  LENGTH
  TIME
}

enum StorageLocationType {
  STOREFRONT
  WAREHOUSE
  KITCHEN
  BAR
  TRANSIT
}

enum StockMovementType {
  SALE
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  OPNAME_ADJUSTMENT
  RETURN
  WASTE
  VOID
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
}

enum InventoryRefType {
  ORDER
  PURCHASE_ORDER
  TRANSFER
  STOCK_OPNAME
  REFUND
  PRODUCTION
  MANUAL
}

enum ActorType {
  USER
  SYSTEM
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
  VOIDED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  QRIS
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  EWALLET
  VOUCHER
  CUSTOMER_DEBT
  CUSTOMER_DEPOSIT
  LAUNDRY_QUOTA
}

enum PaymentTxStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  VOIDED
}

enum RefundReason {
  CUSTOMER_RETURN
  DAMAGED_GOODS
  WRONG_ITEM
  DISSATISFIED_SERVICE
  BILLING_ERROR
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// ==========================================
// 8. SUPPLY CHAIN, PURCHASING & LOGISTICS (EPIC-07)
// ==========================================

model Supplier {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  code             String
  name             String
  contactName      String?  @map("contact_name")
  phone            String?
  email            String?
  address          String?
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  outletId             String              @map("outlet_id")
  storageLocationId    String              @map("storage_location_id")
  supplierId           String              @map("supplier_id")
  poNumber             String              @map("po_number")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  subtotal             Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes                String?
  createdByUserId      String?             @map("created_by_user_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet          Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation     @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser   User?               @relation("POCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, outletId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  purchaseOrderId  String   @map("purchase_order_id")
  inventoryItemId  String   @map("inventory_item_id")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(15, 4)
  subtotal         Decimal  @db.Decimal(15, 2)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model StockTransfer {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  transferNumber     String              @map("transfer_number")
  sourceOutletId     String              @map("source_outlet_id")
  sourceLocationId   String              @map("source_location_id")
  targetOutletId     String              @map("target_outlet_id")
  targetLocationId   String              @map("target_location_id")
  status             StockTransferStatus @default(DRAFT)
  dispatchedAt       DateTime?           @map("dispatched_at")
  receivedAt         DateTime?           @map("received_at")
  dispatchedByUserId String?             @map("dispatched_by_user_id")
  receivedByUserId   String?             @map("received_by_user_id")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceOutlet     Outlet              @relation("TransferSourceOutlet", fields: [sourceOutletId], references: [id], onDelete: Restrict)
  sourceLocation   StorageLocation     @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  targetOutlet     Outlet              @relation("TransferTargetOutlet", fields: [targetOutletId], references: [id], onDelete: Restrict)
  targetLocation   StorageLocation     @relation("TransferTargetLocation", fields: [targetLocationId], references: [id], onDelete: Restrict)
  dispatchedByUser User?               @relation("TransferDispatchedByUser", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  receivedByUser   User?               @relation("TransferReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items            StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, sourceOutletId, targetOutletId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  stockTransferId    String   @map("stock_transfer_id")
  inventoryItemId    String   @map("inventory_item_id")
  inventoryBatchId   String?  @map("inventory_batch_id")
  quantityDispatched Decimal  @map("quantity_dispatched") @db.Decimal(12, 3)
  quantityReceived   Decimal  @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost           Decimal  @default(0) @map("unit_cost") @db.Decimal(15, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockTransfer  StockTransfer   @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([tenantId, stockTransferId])
  @@map("stock_transfer_items")
}

// ==========================================
// 9. CRM, LOYALTY & PROMOTIONS (EPIC-08)
// ==========================================

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PointTxType {
  EARNED_PURCHASE
  REDEEMED_DISCOUNT
  TIER_BONUS
  MANUAL_ADJUSTMENT
  REFUND_DEDUCT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CustomerPointLedger {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  customerId    String      @map("customer_id")
  orderId       String?     @map("order_id")
  deltaPoints   Int         @map("delta_points")
  balanceBefore Int         @map("balance_before")
  balanceAfter  Int         @map("balance_after")
  type          PointTxType
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@map("customer_point_ledgers")
}

model Promotion {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  code              String
  name              String
  description       String?
  scope             String       @default("ORDER") @map("scope") // 'ORDER' (Voucher Global) vs 'ITEM' (Katalog Diskon Produk)
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(15, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(15, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(15, 2)
  usageLimit        Int?         @map("usage_limit")
  usageCount        Int          @default(0) @map("usage_count")
  perCustomerLimit  Int          @default(1) @map("per_customer_limit")
  startDate         DateTime     @map("start_date")
  endDate           DateTime     @map("end_date")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders   Order[]
  usages   PromotionUsage[]
  items    PromotionItem[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, scope])
  @@map("promotions")
}

model PromotionUsage {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  promotionId     String   @map("promotion_id")
  customerId      String?  @map("customer_id")
  orderId         String   @map("order_id")
  discountApplied Decimal  @map("discount_applied") @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, promotionId])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@map("promotion_usages")
}

model PromotionItem {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  promotionId   String        @map("promotion_id")
  productId     String        @map("product_id")
  variantId     String?       @map("variant_id")
  discountType  DiscountType? @map("discount_type") // Jika null, mewarisi tipe diskon program promo
  discountValue Decimal?      @map("discount_value") @db.Decimal(15, 2) // Jika null, mewarisi nilai diskon program promo
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  promotion Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, promotionId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@map("promotion_items")
}

