}

model LaundryRack {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  outletId     String   @map("outlet_id")
  code         String   // RAK-A1, HGR-B1
  name         String
  category     String   @default("KILOAN") // 'KILOAN', 'SATUAN', 'EXPRESS', 'SEPATU_TAS'
  capacity     Int      @default(10)
  locationNote String?  @map("location_note")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@unique([tenantId, outletId, code])
  @@index([tenantId, outletId, isActive])
  @@map("laundry_racks")
}

model LaundryOrderDetail {
  id               String    @id @default(uuid())
  orderId          String    @unique @map("order_id")
  tenantId         String    @map("tenant_id")
  outletId         String    @map("outlet_id")
  status           String    @default("RECEIVED") // 'RECEIVED', 'WASHING_DRYING', 'IRONING_PACKING', 'READY_FOR_PICKUP', 'COMPLETED'
  currentStage     String    @default("DROP_OFF") @map("current_stage") // 11 Stages: DROP_OFF, TAGGING, SORTING, SPOTTING, WASHING, DRYING, IRONING, FOLDING, PACKING, RACK_STORAGE, HANDOVER
  rackCode         String?   @map("rack_code")
  totalWeightKg    Decimal?  @map("total_weight_kg") @db.Decimal(10, 3)
  totalPieces      Int       @default(0) @map("total_pieces")
  perfumeVariant   String?   @map("perfume_variant")
  transferStatus   String?   @default("AT_OUTLET") @map("transfer_status") // 'AT_OUTLET', 'IN_TRANSIT_TO_WORKSHOP', 'AT_WORKSHOP', 'IN_TRANSIT_TO_OUTLET'
  workshopOutletId String?   @map("workshop_outlet_id")
  estimatedReadyAt DateTime? @map("estimated_ready_at")
  completedAt      DateTime? @map("completed_at")
  pickedUpAt       DateTime? @map("picked_up_at")
  pickedUpBy       String?   @map("picked_up_by")
  customerNotes    String?   @map("customer_notes")
  garmentCounts    Json?     @map("garment_counts")
  defects          Json?
  defectNotes      String?   @map("defect_notes")
  conditionPhotos  Json?     @map("condition_photos")
  isSorted         Boolean   @default(false) @map("is_sorted")
  sortedAt         DateTime? @map("sorted_at")
  sortedBy         String?   @map("sorted_by")
  deliveryType          String    @default("NONE") @map("delivery_type") // 'NONE' | 'PICKUP_ONLY' | 'DELIVERY_ONLY' | 'PICKUP_AND_DELIVERY'
  deliveryStatus        String?   @map("delivery_status") // 'PENDING_PICKUP' | 'PICKED_UP' | 'READY_TO_DELIVER' | 'OUT_FOR_DELIVERY' | 'DELIVERED' | 'CANCELLED'
  deliveryFee           Decimal   @default(0) @map("delivery_fee") @db.Decimal(15, 2)
  deliveryZoneName      String?   @map("delivery_zone_name")
  deliveryAddress       String?   @map("delivery_address")
  deliveryNotes         String?   @map("delivery_notes")
  deliveryScheduledAt   DateTime? @map("delivery_scheduled_at")
  courierName           String?   @map("courier_name")
  courierPhone          String?   @map("courier_phone")
  deliveredAt           DateTime? @map("delivered_at")
  deliveryProofPhotoUrl String?   @map("delivery_proof_photo_url")
  isBomDeducted         Boolean   @default(false) @map("is_bom_deducted")
  bomDeductedAt         DateTime? @map("bom_deducted_at")
  lastReminderSentAt    DateTime? @map("last_reminder_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet    Outlet             @relation(fields: [outletId], references: [id], onDelete: Restrict)
  stageLogs LaundryStageLog[]

  @@index([tenantId, outletId, status])
  @@index([tenantId, outletId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, currentStage])
  @@index([tenantId, rackCode])
  @@index([tenantId, transferStatus])
  @@index([tenantId, outletId, deliveryType, deliveryStatus])
  @@index([tenantId, outletId, estimatedReadyAt], map: "idx_laundry_details_tenant_outlet_sla")
  @@map("laundry_order_details")
}

model LaundryTransferManifest {
  id               String    @id @default(uuid())
  manifestNumber   String    @map("manifest_number")
  tenantId         String    @map("tenant_id")
  sourceOutletId   String    @map("source_outlet_id")
  targetOutletId   String    @map("target_outlet_id")
  status           String    @default("DISPATCHED") // 'DISPATCHED', 'RECEIVED', 'CANCELLED'
