  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// ==========================================
// 8. SUPPLY CHAIN, PURCHASING & LOGISTICS (EPIC-07)
// ==========================================

model Supplier {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  code             String
  name             String
  contactName      String?  @map("contact_name")
  phone            String?
  email            String?
  address          String?
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  outletId             String              @map("outlet_id")
  storageLocationId    String              @map("storage_location_id")
  supplierId           String              @map("supplier_id")
  poNumber             String              @map("po_number")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  subtotal             Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes                String?
  createdByUserId      String?             @map("created_by_user_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet          Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation     @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser   User?               @relation("POCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, outletId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  purchaseOrderId  String   @map("purchase_order_id")
  inventoryItemId  String   @map("inventory_item_id")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(15, 4)
  subtotal         Decimal  @db.Decimal(15, 2)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model StockTransfer {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  transferNumber     String              @map("transfer_number")
  sourceOutletId     String              @map("source_outlet_id")
  sourceLocationId   String              @map("source_location_id")
  targetOutletId     String              @map("target_outlet_id")
  targetLocationId   String              @map("target_location_id")
  status             StockTransferStatus @default(DRAFT)
  dispatchedAt       DateTime?           @map("dispatched_at")
  receivedAt         DateTime?           @map("received_at")
  dispatchedByUserId String?             @map("dispatched_by_user_id")
  receivedByUserId   String?             @map("received_by_user_id")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceOutlet     Outlet              @relation("TransferSourceOutlet", fields: [sourceOutletId], references: [id], onDelete: Restrict)
  sourceLocation   StorageLocation     @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  targetOutlet     Outlet              @relation("TransferTargetOutlet", fields: [targetOutletId], references: [id], onDelete: Restrict)
  targetLocation   StorageLocation     @relation("TransferTargetLocation", fields: [targetLocationId], references: [id], onDelete: Restrict)
  dispatchedByUser User?               @relation("TransferDispatchedByUser", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  receivedByUser   User?               @relation("TransferReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items            StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, sourceOutletId, targetOutletId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  stockTransferId    String   @map("stock_transfer_id")
  inventoryItemId    String   @map("inventory_item_id")
  inventoryBatchId   String?  @map("inventory_batch_id")
  quantityDispatched Decimal  @map("quantity_dispatched") @db.Decimal(12, 3)
  quantityReceived   Decimal  @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost           Decimal  @default(0) @map("unit_cost") @db.Decimal(15, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockTransfer  StockTransfer   @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  @@index([tenantId, stockTransferId])
  @@map("stock_transfer_items")
}

// ==========================================
// 9. CRM, LOYALTY & PROMOTIONS (EPIC-08)
// ==========================================

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PointTxType {
  EARNED_PURCHASE
  REDEEMED_DISCOUNT
  TIER_BONUS
  MANUAL_ADJUSTMENT
  REFUND_DEDUCT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CustomerPointLedger {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  customerId    String      @map("customer_id")
  orderId       String?     @map("order_id")
  deltaPoints   Int         @map("delta_points")
  balanceBefore Int         @map("balance_before")
  balanceAfter  Int         @map("balance_after")
  type          PointTxType
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@map("customer_point_ledgers")
}

model Promotion {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  code              String
  name              String
  description       String?
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(15, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(15, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(15, 2)
  usageLimit        Int?         @map("usage_limit")
  usageCount        Int          @default(0) @map("usage_count")
  perCustomerLimit  Int          @default(1) @map("per_customer_limit")
  startDate         DateTime     @map("start_date")
  endDate           DateTime     @map("end_date")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders   Order[]
  usages   PromotionUsage[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("promotions")
}

model PromotionUsage {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  promotionId     String   @map("promotion_id")
  customerId      String?  @map("customer_id")
  orderId         String   @map("order_id")
  discountApplied Decimal  @map("discount_applied") @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, promotionId])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@map("promotion_usages")
}

// ==========================================
// 12. CUSTOMER DEBTS & RECEIVABLES (KASBON)
// ==========================================

enum CustomerDebtStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model CustomerDebt {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  outletId        String             @map("outlet_id")
  customerId      String             @map("customer_id")
  orderId         String             @map("order_id")
  totalAmount     Decimal            @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal            @default(0) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal            @map("remaining_amount") @db.Decimal(15, 2)
  dueDate         DateTime?          @map("due_date")
  status          CustomerDebtStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet   Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments CustomerDebtPayment[]

  @@index([tenantId, customerId])
  @@index([tenantId, outletId])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("customer_debts")
}

model CustomerDebtPayment {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  debtId          String        @map("debt_id")
  outletId        String        @map("outlet_id")
  cashierId       String?       @map("cashier_id")
  shiftId         String?       @map("shift_id")
  amount          Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  referenceNumber String?       @map("reference_number")
  notes           String?
  paidAt          DateTime      @default(now()) @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  debt    CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Restrict)
  outlet  Outlet       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  cashier User?        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  shift   Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([tenantId, debtId])
  @@index([tenantId, outletId])
  @@index([tenantId, shiftId])
  @@map("customer_debt_payments")
}



