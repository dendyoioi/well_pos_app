  kgBefore      Decimal   @default(0) @map("kg_before") @db.Decimal(12, 3)
  kgAfter       Decimal   @default(0) @map("kg_after") @db.Decimal(12, 3)
  paymentMethod String?   @map("payment_method")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  wallet  CustomerLaundryWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet  Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  order   Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shift   Shift?                @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashier User?                 @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  @@index([tenantId, walletId])
  @@index([tenantId, orderId])
  @@index([tenantId, shiftId])
  @@index([tenantId, createdAt])
  @@map("customer_laundry_wallet_ledgers")
}

model LaundryServiceBomItem {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  laundryServiceId String   @map("laundry_service_id")
  inventoryItemId  String   @map("inventory_item_id")
  quantityPerUnit  Decimal  @map("quantity_per_unit") @db.Decimal(12, 3) // Base Unit: ML, GRAM, PCS
  consumptionBasis String   @default("PER_UNIT") @map("consumption_basis") // 'PER_UNIT' | 'PER_ORDER'
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  laundryService LaundryService @relation(fields: [laundryServiceId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([laundryServiceId, inventoryItemId])
  @@index([tenantId, laundryServiceId])
  @@map("laundry_service_bom_items")
}

model ShiftCashDeposit {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  outletId        String    @map("outlet_id")
  shiftId         String    @map("shift_id")
  cashierId       String    @map("cashier_id")
  amount          Decimal   @db.Decimal(15, 2)
  targetAccount   String    @map("target_account")
  referenceNumber String?   @map("reference_number")
  proofPhotoUrl   String?   @map("proof_photo_url")
  notes           String?
  status          String    @default("PENDING") // 'PENDING' | 'VERIFIED' | 'REJECTED'
  verifiedById    String?   @map("verified_by_id")
  verifiedAt      DateTime? @map("verified_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  shift    Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  cashier  User   @relation("DepositCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  verifier User?  @relation("DepositVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([tenantId, outletId, status])
  @@index([tenantId, shiftId])
  @@map("shift_cash_deposits")
}

model StaffCashAdvance {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  outletId        String    @map("outlet_id")
  staffId         String?   @map("staff_id")
  staffName       String    @map("staff_name")
  amount          Decimal   @db.Decimal(15, 2)
  remainingAmount Decimal   @map("remaining_amount") @db.Decimal(15, 2)
  status          String    @default("OPEN") // 'OPEN' | 'PARTIAL' | 'PAID' | 'CANCELLED'
  reason          String?
  shiftId         String?   @map("shift_id")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  staff  User?   @relation("StaffCashAdvanceUser", fields: [staffId], references: [id], onDelete: SetNull)
  shift  Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([tenantId, outletId, status])
  @@map("staff_cash_advances")
}

model SchemaPatch {
  id          String    @id
  description String?
  appliedAt   DateTime? @default(now()) @map("applied_at")

  @@map("_schema_patches")
}

model LaundryCustomerFeedback {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  outletId           String    @map("outlet_id")
  orderId            String    @unique @map("order_id")
  customerId         String?   @map("customer_id")
  rating             Int
  category           String?   // QUALITY | SPEED | SERVICE | CLEANLINESS | OTHER
  comment            String?   @db.Text
  photoUrl           String?   @map("photo_url")
  isComplaint        Boolean   @default(false) @map("is_complaint")
  redirectedToGoogle Boolean   @default(false) @map("redirected_to_google")
  status             String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED
  resolutionNotes    String?   @map("resolution_notes") @db.Text
  handledById        String?   @map("handled_by_id")
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handledBy User?     @relation("FeedbackHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([outletId, status, createdAt])
  @@index([tenantId, outletId, rating])
  @@map("laundry_customer_feedbacks")
}

model LaundryPerfume {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  outletId        String?        @map("outlet_id")
  name            String
  extraPrice      Decimal        @default(0) @map("extra_price") @db.Decimal(15, 2)
  inventoryItemId String?        @map("inventory_item_id")
  usageQtyPerUnit Decimal        @default(0) @map("usage_qty_per_unit") @db.Decimal(12, 4)
  usageBasis      String         @default("PER_KG") @map("usage_basis") // "PER_KG" | "PER_ORDER"
  isActive        Boolean        @default(true) @map("is_active")
  isDefault       Boolean        @default(false) @map("is_default")
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet          Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive, sortOrder])
  @@map("laundry_perfumes")
}

model LaundryMachine {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  outletId    String   @map("outlet_id")
  code        String
  name        String
  machineType String   @map("machine_type") // "WASHER" | "DRYER"
  capacityKg  Decimal? @map("capacity_kg") @db.Decimal(10, 2)
  status      String   @default("ACTIVE") // "ACTIVE" | "MAINTENANCE" | "INACTIVE"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, code])
  @@index([tenantId, outletId])
  @@map("laundry_machines")
}
