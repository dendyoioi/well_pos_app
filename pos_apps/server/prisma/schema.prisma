  unit              String   @default("KG") // 'KG', 'PCS', 'PASANG', 'METER'
  price             Decimal  @default(0) @db.Decimal(15, 2)
  minOrderQty       Decimal  @default(1.00) @map("min_order_qty") @db.Decimal(10, 2)
