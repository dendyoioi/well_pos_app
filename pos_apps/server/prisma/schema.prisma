  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet     Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user       User    @relation("StaffLeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("StaffLeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, outletId, status])
  @@index([tenantId, userId, startDate])
  @@map("staff_leave_requests")
}

model StaffPayrollSlip {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  outletId             String    @map("outlet_id")
  userId               String    @map("user_id")
  periodYear           Int       @map("period_year")
  periodMonth          Int       @map("period_month")
  baseSalary           Decimal   @default(0) @map("base_salary") @db.Decimal(15, 2)
  overtimePay          Decimal   @default(0) @map("overtime_pay") @db.Decimal(15, 2)
  commissionPay        Decimal   @default(0) @map("commission_pay") @db.Decimal(15, 2)
  bonusAmount          Decimal   @default(0) @map("bonus_amount") @db.Decimal(15, 2)
  cashAdvanceDeduction Decimal   @default(0) @map("cash_advance_deduction") @db.Decimal(15, 2)
  otherDeduction       Decimal   @default(0) @map("other_deduction") @db.Decimal(15, 2)
  netSalary            Decimal   @default(0) @map("net_salary") @db.Decimal(15, 2)
  status               String    @default("DRAFT") // DRAFT | FINALIZED | PAID
  paidAt               DateTime? @map("paid_at")
  paymentMethod        String?   @map("payment_method")
  notes                String?   @db.Text
  generatedById        String?   @map("generated_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user        User    @relation("StaffPayrollUser", fields: [userId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation("StaffPayrollGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, outletId, userId, periodYear, periodMonth])
  @@index([tenantId, outletId, status])
  @@map("staff_payroll_slips")
}

model GlobalAuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  outletId    String?  @map("outlet_id")
  actorUserId String?  @map("actor_user_id")
  actorName   String?  @map("actor_name")
  actorRole   String?  @map("actor_role")
  module      String   // PROCUREMENT | HR_PAYROLL | ORDER | PRICING | FINANCE | SECURITY | SYSTEM
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String   @db.Text
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  actorUser User?   @relation("GlobalAuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, module, createdAt])
  @@index([tenantId, outletId, createdAt])
  @@map("global_audit_logs")
}
