  TRANSFER_IN
  TRANSFER_OUT
  OPNAME_ADJUSTMENT
  RETURN
  WASTE
  VOID
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
}

enum InventoryRefType {
