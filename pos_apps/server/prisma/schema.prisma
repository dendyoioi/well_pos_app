  FNB
  SERVICES
  HYBRID
}

enum BillingCycle {
  MONTHLY
  ANNUALLY
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  VOID
}

enum PaymentRecordStatus {
