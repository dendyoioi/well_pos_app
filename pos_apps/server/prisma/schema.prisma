enum CustomerDebtStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model CustomerDebt {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  outletId        String             @map("outlet_id")
  customerId      String             @map("customer_id")
  orderId         String             @map("order_id")
  totalAmount     Decimal            @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal            @default(0) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal            @map("remaining_amount") @db.Decimal(15, 2)
  dueDate         DateTime?          @map("due_date")
  status          CustomerDebtStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet   Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments CustomerDebtPayment[]

  @@index([tenantId, customerId])
  @@index([tenantId, outletId])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("customer_debts")
}

model CustomerDebtPayment {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  debtId          String        @map("debt_id")
  outletId        String        @map("outlet_id")
  cashierId       String?       @map("cashier_id")
  shiftId         String?       @map("shift_id")
  amount          Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  referenceNumber String?       @map("reference_number")
  notes           String?
  paidAt          DateTime      @default(now()) @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  debt    CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Restrict)
  outlet  Outlet       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  cashier User?        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  shift   Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([tenantId, debtId])
  @@index([tenantId, outletId])
  @@index([tenantId, shiftId])
  @@map("customer_debt_payments")
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
}

model Attendance {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  outletId        String           @map("outlet_id")
  userId          String           @map("user_id")
  workDate        String           @map("work_date") // YYYY-MM-DD sesuai zona waktu outlet
  clockIn         DateTime         @default(now()) @map("clock_in")
  clockOut        DateTime?        @map("clock_out")
  durationMinutes Int?             @map("duration_minutes")
  lateMinutes     Int?             @default(0) @map("late_minutes")
  status          AttendanceStatus @default(ON_TIME)
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, outletId, workDate])
  @@index([tenantId, userId, workDate])
  @@map("attendances")
}

model EmailVerification {
  id         String    @id @default(uuid())
  email      String
  otpHash    String    @map("otp_hash")
  purpose    String    @default("REGISTRATION") // 'REGISTRATION' | 'PASSWORD_RESET'
  expiresAt  DateTime  @map("expires_at")
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose, isVerified])
  @@map("email_verifications")
}

